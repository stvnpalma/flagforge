{
  "info": {
    "name": "FlagForge API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://<api-id>.execute-api.us-east-1.amazonaws.com/prod",
      "type": "string"
    },
    {
      "key": "bearerToken",
      "value": "PASTE_YOUR_COGNITO_ID_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string"
    },
    {
      "key": "envId",
      "value": "",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/projects",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My First Project\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/projects"
          }
        },
        {
          "name": "Get Project",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/projects/{{projectId}}"
          }
        }
      ]
    },
    {
      "name": "Environments",
      "item": [
        {
          "name": "Create Environment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/projects/{{projectId}}/environments",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Production\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "List Environments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/projects/{{projectId}}/environments"
          }
        }
      ]
    },
    {
      "name": "Flags",
      "item": [
        {
          "name": "Create Flag",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/projects/{{projectId}}/flags",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flagKey\": \"new-checkout-flow\",\n  \"name\": \"New checkout flow\",\n  \"description\": \"Rolls out the redesigned checkout\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "List Flags",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/projects/{{projectId}}/flags"
          }
        },
        {
          "name": "Get Flag",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/projects/{{projectId}}/flags/new-checkout-flow"
          }
        },
        {
          "name": "Set Flag State",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/projects/{{projectId}}/flags/new-checkout-flow/environments/{{envId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get Flag State",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/projects/{{projectId}}/flags/new-checkout-flow/environments/{{envId}}"
          }
        }
      ]
    },
    {
      "name": "Evaluation",
      "item": [
        {
          "name": "Evaluate All Flags",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/projects/{{projectId}}/environments/{{envId}}/evaluate",
            "description": "Returns every flag for the environment as { flagKey: boolean }. Auth: API key (x-api-key), not Cognito. Responses: 200 flag map (empty object for an unknown environment); 401 missing or invalid key; 403 the key belongs to a different project."
          }
        },
        {
          "name": "Evaluate Single Flag",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/projects/{{projectId}}/environments/{{envId}}/evaluate/new-checkout-flow",
            "description": "Returns { flagKey, enabled }. An unknown flag returns enabled false (fail closed). Auth: API key (x-api-key). Responses: 200; 400 missing path parameters; 401 missing or invalid key; 403 the key belongs to a different project."
          }
        }
      ]
    },
    {
      "name": "API Keys",
      "item": [
        {
          "name": "Create API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.apiKey) {",
                  "  pm.collectionVariables.set('apiKey', body.data.apiKey);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/projects/{{projectId}}/api-keys",
            "description": "Generates an evaluation API key for the project. The raw key is returned once and only its hash is stored; the test script saves it to the apiKey variable. Auth: Cognito JWT. Responses: 201 { apiKey, projectId, createdAt }; 400 missing projectId; 401 missing or invalid token; 404 project does not exist."
          }
        }
      ]
    }
  ]
}
